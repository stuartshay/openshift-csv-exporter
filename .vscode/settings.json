{
  "files.watcherExclude": {
    "**/output/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true
  },
  "files.exclude": {
    "**/.git": true
  },
  "shellcheck.enable": true,
  "shellcheck.executablePath": "shellcheck",
  "files.associations": {
    "*.sh": "shellscript"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": [
    "datastore",
    "notebook"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingTypeStubs": "none",
    "reportMissingImports": "none"
  },
  "pylint.importStrategy": "fromEnvironment",
  "pylint.args": [
    "--disable=line-too-long,broad-except,unspecified-encoding,missing-module-docstring,missing-class-docstring,missing-function-docstring,import-error,not-callable,invalid-name",
    "--ignore-paths=^.*\\.venv/.*$",
    "--ignore-patterns=.*\\.ipynb$"
  ],
  "pylint.ignorePatterns": [
    ".*\\.ipynb$"
  ],
  "pydocstyle.args": [
    "--add-ignore=D100,D101,D102,D103,D104,D105,D106,D107",
    "--match=(?!.*\\.ipynb).*\\.py"
  ],
  "mypy-type-checker.args": [
    "--ignore-missing-imports",
    "--exclude=.*\\.ipynb$"
  ],
  "flake8.args": [
    "--max-line-length=999",
    "--extend-ignore=E501",
    "--exclude=*.ipynb,.venv,__pycache__"
  ],
  "flake8.ignorePatterns": [
    ".*\\.ipynb$"
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  }
}
